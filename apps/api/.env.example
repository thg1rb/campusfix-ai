API_PORT=8080
DATABASE_URL=postgresql://kuspot:kuspot-local@127.0.0.1:5432/kuspot?sslmode=disable
AI_BASE_URL=http://127.0.0.1:8000
APP_BASE_URL=http://localhost:3000
# Defaults to true for loopback APP_BASE_URL hosts and false elsewhere.
# SWAGGER_ENABLED=true
# Generate a secret with: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Defaults to secure for HTTPS and insecure for local HTTP.
# AUTH_COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to APP_BASE_URL/api/v1/auth/callback
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/callback
GOOGLE_OAUTH_ALLOWED_DOMAIN=ku.th
BOOTSTRAP_ADMIN_EMAILS=
# Reserved for future object storage:
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
