AI_PORT=8000
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=20
AI_ENABLE_DOCS=true
AI_MAX_REQUEST_BODY_BYTES=25165824

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Comma-separated ASCII X-API-Key values for authorized callers (Go backend / external clients).
# Required whenever GEMINI_API_KEY is configured, unless AI_ALLOW_ANONYMOUS=true is explicitly set for local dev.
AI_CLIENT_API_KEYS=
AI_ALLOW_ANONYMOUS=false

# Reserved for future JEV integration:
# JEV_BASE_URL=
# JEV_API_KEY=
