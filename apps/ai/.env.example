AI_PORT=8000
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=20
AI_ENABLE_DOCS=true

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Optional comma-separated X-API-Key values for external university clients.
# Leave empty during local development to allow unauthenticated calls.
AI_CLIENT_API_KEYS=

# Reserved for future JEV integration:
# JEV_BASE_URL=
# JEV_API_KEY=
